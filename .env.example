# ── Required ───────────────────────────────────────────────
# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster/db)
MONGODB_URI=
MONGODB_DB=crisiswatch

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Shared secret for /trigger-pipeline, /outbreaks/detect, /workers/{id}/verify
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# ── Optional: research thin records with Tavily ────────────
# Free plan: 1,000 credits/month, 1 credit per basic search.
# Leave blank to disable — the pipeline works without it.
TAVILY_API_KEY=
MAX_RESEARCH_PER_RUN=2
RESEARCH_PAGES=3
RESEARCH_COOLDOWN_HOURS=24
TAVILY_SEARCH_DEPTH=basic

# News corroboration (noisy, off by default)
ENABLE_GDELT=

# ── Optional tuning ────────────────────────────────────────
MAX_ARTICLES_PER_RUN=24
FETCH_CONCURRENCY=5
GEMINI_CONCURRENCY=2
MIN_CONFIDENCE=0.30
CORS_ORIGINS=*
